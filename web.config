<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows) / IIS: run the Express host through iisnode.
  Every request is handed to Express (bin/www), which serves only ./public and applies
  the security headers. Nothing else in the deployed folder (package.json, relay.py,
  app.js, tests) is ever served directly by IIS.
  Linux App Service ignores this file and uses `npm start`.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="bin/www" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^bin\/www\/debug[\/]?" />
        </rule>
        <rule name="AllToExpress" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="bin/www" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode node_env="production" watchedFiles="web.config;*.js" loggingEnabled="false" devErrorsEnabled="false" />
  </system.webServer>
</configuration>

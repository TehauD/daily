{
  "name": "veritas",
  "version": "1.0.0",
  "private": true,
  "description": "The Daily \u2014 a local-first developer journal. Single-page app served by a small Express host.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/www",
    "relay": "python3 relay.py",
    "dev": "NODE_ENV=development node ./bin/www",
    "test": "node --test && python3 -m unittest discover -s test -p \"test_*.py\"",
    "test:node": "node --test",
    "test:relay": "python3 -m unittest discover -s test -p \"test_*.py\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "http-errors": "~1.6.3",
    "morgan": "^1.12.1"
  }
}

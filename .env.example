# ─────────────────────────────────────────────────────────────────────────────
# The Daily — local configuration
#
#   cp .env.example .env      then fill in what you use and run:  python relay.py
#
# .env is listed in .gitignore. Never commit it, paste it into an issue, or
# share it in a screenshot. Everything here stays on your machine: the relay
# uses these values server-side and never sends them to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Relay server ─────────────────────────────────────────────────────────────
DAILY_HOST=127.0.0.1          # keep loopback; other addresses require DAILY_CLIENT_KEY
DAILY_PORT=8000
# Optional shared secret required on every /api and /v1 call. Recommended if
# other people use this computer, and REQUIRED if DAILY_HOST is not loopback.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then open the app once as  http://127.0.0.1:8000/#relay-key=<key>
# DAILY_CLIENT_KEY=
# Extra browser origins allowed to call the relay (e.g. the Express host):
# DAILY_ALLOWED_ORIGINS=http://localhost:3000

# ── Active provider & publishing ─────────────────────────────────────────────
# Which integration the app starts on: github or ado. You can switch at any time
# in Repository → Settings; the choice is remembered per browser.
DAILY_PROVIDER=github
# commit = write straight to the branch; pr = each entry on its own branch + pull request
DAILY_PUBLISH_MODE=commit
DAILY_PR_BRANCH_PREFIX=journal    # PR branches look like journal/2026-10-10-my-title
DAILY_MIRROR=false                # true = also push a copy to the other provider by default
DAILY_ASSETS=true                 # store pasted images as files in <day>/assets/ instead of inline
DAILY_MAX_ASSET_MB=10

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT, only this repository, with an expiry. Permissions:
#   Contents: Read and write        push / pull entries and images (required)
#   Pull requests: Read and write   only if you publish via pull request
#   Issues: Read and write          the Issues drawer
#   Actions: Read (Read and write to re-run)   the Actions tab
DAILY_GITHUB_TOKEN=
DAILY_GITHUB_OWNER=
DAILY_GITHUB_REPOSITORY=
DAILY_GITHUB_BRANCH=main
DAILY_GITHUB_ROOT=journal     # folder inside the repo; the relay only touches .md files and assets/ images under it
DAILY_GITHUB_ISSUES_ENABLED=true
DAILY_GITHUB_ISSUE_TYPES=Bug,Task,Feature   # matched to labels (Feature ↔ "enhancement")
DAILY_GITHUB_ACTIONS_ENABLED=true

# GitHub Projects (v2) board — optional. The number is in the project URL
# (github.com/users/<you>/projects/<number>). Fine-grained tokens can't reach
# projects owned by a personal account yet, so for those put a classic token
# with only the "project" scope here. Org-owned projects work with a
# fine-grained token that has Organization → Projects: Read and write.
# DAILY_GITHUB_PROJECT_NUMBER=1
# DAILY_GITHUB_PROJECT_OWNER=        # defaults to DAILY_GITHUB_OWNER
# DAILY_GITHUB_PROJECT_STATUS_FIELD=Status
# DAILY_GITHUB_PROJECTS_TOKEN=       # defaults to DAILY_GITHUB_TOKEN

# ── Azure DevOps (repository and/or Boards) ──────────────────────────────────
DAILY_ADO_ENABLED=false
# PAT scoped to ONE organization. Scopes: Code (Read & write) — this also covers
# pull requests. Add Work Items (Read & write) if you enable Boards below, and
# Build (Read & execute) for the Pipelines tab.
DAILY_ADO_PAT=
DAILY_ADO_ORGANIZATION=
DAILY_ADO_PROJECT=
DAILY_ADO_REPOSITORY=         # leave empty to use Boards without repository sync
DAILY_ADO_BRANCH=main
DAILY_ADO_ROOT=journal
DAILY_ADO_PIPELINES_ENABLED=true

# Boards / work items drawer
DAILY_ADO_WIT_ENABLED=false
DAILY_ADO_WIT_TYPES=Bug,Task,User Story
DAILY_ADO_WIT_DEFAULT_TYPE=Task
DAILY_ADO_WIT_MULTI_PROJECT=true
# Optional allow-list of projects the drawer may switch to (comma-separated):
# DAILY_ADO_WIT_PROJECTS=Project A,Project B

# ── AI provider ──────────────────────────────────────────────────────────────
# Easiest: Studio → AI model → "Set up with the relay" writes these lines for you.
#
# DAILY_AI_PROVIDER:
#   azure       Azure OpenAI / Microsoft Foundry (alias: foundry). Base URL:
#               https://<resource>.openai.azure.com/openai/v1   (no API version needed)
#               DAILY_AI_MODEL is the DEPLOYMENT name shown in Foundry.
#   anthropic   Claude. Base URL defaults to https://api.anthropic.com; for Claude in Foundry use
#               https://<resource>.services.ai.azure.com/anthropic
#   openai | gemini | openrouter | groq | mistral | deepseek | xai | together   (base URL preset)
#   ollama | lmstudio      local servers, no key
#   compatible             any other OpenAI-compatible server (set DAILY_AI_BASE_URL)
DAILY_AI_PROVIDER=openai
DAILY_AI_BASE_URL=
DAILY_AI_API_KEY=
DAILY_AI_MODEL=
DAILY_AI_MAX_TOKENS=4000          # hard cap per request (cost guard)

# Azure / Foundry without keys (Microsoft Entra ID). Sign in once with `az login`,
# or fill in a service principal. Needs the "Cognitive Services OpenAI User" or
# "Foundry User" role on the resource.
# DAILY_AI_AUTH=entra
# DAILY_AI_TENANT_ID=
# DAILY_AI_CLIENT_ID=
# DAILY_AI_CLIENT_SECRET=
# Only for the classic /openai/deployments route; leave empty for the v1 endpoint:
# DAILY_AI_API_VERSION=

# Reasoning models (gpt-5*, o*, DeepSeek-R1…) are detected by name. Force it when a
# custom deployment name hides the family:
# DAILY_AI_REASONING=on
# DAILY_AI_REASONING_EFFORT=low
# DAILY_AI_REASONING_MIN_TOKENS=1024

# ── Journal folder ───────────────────────────────────────────────────────────
# Every note is also a Markdown file here, kept in step both ways with the app.
# Relative paths are inside this project (vault/ is git-ignored); an absolute path
# can point at an Obsidian vault, a synced folder or a git working copy.
DAILY_VAULT=true
DAILY_VAULT_DIR=vault

# ── Experimental ─────────────────────────────────────────────────────────────
DAILY_ENTERPRISE_ENABLED=false
DAILY_ENTERPRISE_UI=false
# DAILY_DATA_DIR=.daily-data

# ─────────────────────────────────────────────────────────────────────────────
# Express static host (npm start). Only needed if you deploy the public, credential-
# free copy, e.g. to Azure App Service. It never uses the DAILY_* values above.
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # use "production" when deployed
# EXTRA_CONNECT_SRC=https://my-llm.example.com
# Legacy server-side save endpoint, off unless JOURNAL_API_KEY is set:
# JOURNAL_API_KEY=
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=
